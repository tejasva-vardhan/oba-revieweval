+func (api *RestAPI) getVehicleTripIDOr404(w http.ResponseWriter, r *http.Request, agencyID, vehicleID string) (string, bool) {
+	vehicle, err := api.GtfsManager.GetVehicleByID(vehicleID)
+	if err != nil {
